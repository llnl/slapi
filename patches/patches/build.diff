@@ -0,0 +1,13 @@
+# coding: utf-8
+
+import json
+import datetime
+
+class DateTimeEncoder(json.JSONEncoder):
+    def default(self, z):
+        if isinstance(z, datetime.datetime):
+            return (str(z))
+        if isinstance(z, datetime.date):
+            return (str(z))
+        else:
+            return super().default(z)
